{
  "color": {
    "background": {
      "primary": { "$type": "color", "$value": "#FFFFFF" },
      "secondary": { "$type": "color", "$value": "#F5F6F8" }
    },
    "text": {
      "primary": { "$type": "color", "$value": "#111827" },
      "secondary": { "$type": "color", "$value": "#6B7280" },
      "link": { "$type": "color", "$value": "#2563EB" }
    }
  },
  "spacing": {
    "xs": { "$type": "dimension", "$value": "4px" },
    "s": { "$type": "dimension", "$value": "8px" },
    "m": { "$type": "dimension", "$value": "16px" },
    "l": { "$type": "dimension", "$value": "24px" },
    "xl": { "$type": "dimension", "$value": "32px" }
  },
  "radius": {
    "m": { "$type": "dimension", "$value": "12px" }
  },
  "typography": {
    "heading/l": {
      "$type": "typography",
      "$value": { "fontFamily": "Inter", "fontWeight": 700, "fontSize": "28px", "lineHeight": "34px" }
    },
    "body/m": {
      "$type": "typography",
      "$value": { "fontFamily": "Inter", "fontWeight": 400, "fontSize": "16px", "lineHeight": "22px" }
    }
  }
}
